# The Academic Assistant database. SHELF only ever reads it, and it never runs
# a migration -- the assistant's repository owns the schema and is the only
# place `alembic upgrade head` is run.
DATABASE_URL=postgresql+psycopg://academic_assistant:dev_password@localhost:5432/academic_assistant

APP_ENV=dev                  # dev | prod. prod makes the session cookie Secure.
LOG_LEVEL=INFO
LOG_FORMAT=console           # console | json - use json wherever logs are shipped
SQL_ECHO=false

# A page render holds its connection for milliseconds, so this is much smaller
# than the assistant's pool, where a turn holds one across an LLM call.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

WEB_LINK_MINUTES=15          # how long an unopened login link stays good
WEB_SESSION_DAYS=30          # idle timeout for a signed-in browser
WEB_DEVICES=2                # browsers per student; a third evicts the oldest
# MUST match the assistant's GRACE_DAYS. If it does not, a student in grace is
# answered in chat and locked out of their own files, which reads as broken.
GRACE_DAYS=3

# Where to send someone whose link expired, and what the sign-up flow deep-links
# to. Digits only, 91XXXXXXXXXX — the shape ck_users_ph_no_digits enforces.
WHATSAPP_CHAT_URL=
WHATSAPP_DISPLAY_NUMBER=919380651594

# --- legal identity ---------------------------------------------------------
# Every one of these is printed verbatim on a published policy page. The site
# REFUSES TO START in production while any is blank: a privacy policy reading
# "[GRIEVANCE OFFICER NAME]" is worse than none, because it is a visible
# admission that nobody read it — and it is the first page a payment
# aggregator opens during merchant activation.
LEGAL_ENTITY=                     # registered name of the entity taking the money
LEGAL_ENTITY_TYPE=                # sole proprietorship | LLP | private limited
LEGAL_ADDRESS=                    # registered address, as on the GST or MCA record
SUPPORT_EMAIL=                    # a mailbox a person actually reads
SUPPORT_PHONE=                    # Razorpay's contact-page check looks for one
# A named human, required by BOTH the DPDP Act s.13 and the Consumer
# Protection (E-Commerce) Rules 2020. Not a role address alone.
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
JURISDICTION_CITY=                # the city whose courts the terms name
POLICY_EFFECTIVE_DATE=            # YYYY-MM-DD, changed when a policy changes
RIGHTS_RESPONSE_DAYS=30           # what the privacy policy promises, and must meet
REFUND_WINDOW_DAYS=7              # full refund window on a first subscription

# Empty means not GST-registered. If set, it prints on the contact page and the
# terms state whether ₹89 includes tax — CLAUDE.md lists both as open questions.
GST_NUMBER=
PRICE_INCLUDES_GST=true

# Cloudflare R2. Empty falls back to an in-memory store, which is fine on a
# laptop and silent in production - every file would be lost on restart while
# the resources row outlives it pointing at a key that is gone.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Google sign-in --------------------------------------------------------
# From the Google Cloud console's OAuth client. The redirect URI registered
# there must be exactly  <SITE_URL>/auth/google/callback  -- Google compares it
# character for character, and the token exchange sends it a second time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the visitor cookie, which carries the pre-payment identity (who Google
# says somebody is, and which number they proved). Treat it exactly like a
# password: anyone holding it can mint a cookie claiming to be any Google
# account. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# This site's public origin, e.g. https://shelf.example. The Google redirect
# URI is built from it rather than from the request, so a forwarded Host
# header cannot decide where a sign-in returns to.
SITE_URL=

# How long a verified number is remembered, so somebody coming back does not
# re-prove a number they already proved. Only a finished verification is kept.
VERIFIED_PHONE_DAYS=30
