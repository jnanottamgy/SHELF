# The Academic Assistant database. SHELF only ever reads it, and it never runs
# a migration -- the assistant's repository owns the schema and is the only
# place `alembic upgrade head` is run.
DATABASE_URL=postgresql+psycopg://academic_assistant:dev_password@localhost:5432/academic_assistant

APP_ENV=dev                  # dev | prod. prod makes the session cookie Secure.
LOG_LEVEL=INFO
LOG_FORMAT=console           # console | json - use json wherever logs are shipped
SQL_ECHO=false

# A page render holds its connection for milliseconds, so this is much smaller
# than the assistant's pool, where a turn holds one across an LLM call.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

WEB_LINK_MINUTES=15          # how long an unopened login link stays good
WEB_SESSION_DAYS=30          # idle timeout for a signed-in browser
WEB_DEVICES=2                # browsers per student; a third evicts the oldest
# MUST match the assistant's GRACE_DAYS. If it does not, a student in grace is
# answered in chat and locked out of their own files, which reads as broken.
GRACE_DAYS=3

# Where to send someone whose link expired, and what the sign-up flow deep-links
# to. Digits only, 91XXXXXXXXXX — the shape ck_users_ph_no_digits enforces.
WHATSAPP_CHAT_URL=
WHATSAPP_DISPLAY_NUMBER=919380651594

# Cloudflare R2. Empty falls back to an in-memory store, which is fine on a
# laptop and silent in production - every file would be lost on restart while
# the resources row outlives it pointing at a key that is gone.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
